# 공공데이터포털(기상청_단기예보 조회서비스) 인증키 또는 기상청 API허브(apihub.kma.go.kr) 통합 인증키
# 실제 인증키는 공개 저장소/GitHub/채팅에 올리지 마세요. 배포 서비스의 Secret 환경변수에 직접 등록하세요.
KMA_SERVICE_KEY=

# 기상청 API허브 > 레이더 HSR 분포도 권한 인증키 (미입력 시 KMA_SERVICE_KEY를 자동 공용 사용)
KMA_RADAR_KEY=

# 기상청 API허브 > 고속도로 노선 도로기상관측(road_stn_obs.php) 인증키 (미입력 시 KMA_SERVICE_KEY를 자동 공용 사용)
KMA_ROAD_KEY=

# 고속도로 노선 번호 (기본값: 14 = 무안광주대구선)
ROAD_LINE_CODE=14

PORT=3000
